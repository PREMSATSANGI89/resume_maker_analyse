# Copy this file to .env and fill in your own values. .env is gitignored.

# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Any model ID from https://openrouter.ai/models — defaults to a free model if unset.
OPENROUTER_MODEL=openai/gpt-oss-20b:free

# Port the backend API server listens on.
PORT=8787

# --- Affinda Search & Match (Job Description Matcher) ---
# Backend-only credential. Never expose it to the React app or commit a real key.
# Get one at https://app.affinda.com/organisation/api-keys
AFFINDA_API_KEY=

# Affinda matches *documents*, so the resume and job description are uploaded into a
# collection first. Leave these blank to auto-discover the first resume / job-description
# collection in your Affinda workspace, or pin them for a predictable target.
AFFINDA_RESUME_COLLECTION=
AFFINDA_JOB_DESCRIPTION_COLLECTION=

# Optional. Only needed if auto-discovery picks the wrong workspace.
AFFINDA_WORKSPACE=

# Optional. Name of a "resumes" search index. When set, the matcher also returns the
# matched/missing skills breakdown; without it you get the score and criteria only.
AFFINDA_RESUME_INDEX=
